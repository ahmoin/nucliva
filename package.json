{
  "name": "nucliva",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "auth:generate": "pnpm --filter web run auth:generate",
    "build": "turbo build",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:push": "pnpm --filter @workspace/db db:push",
    "db:studio": "pnpm --filter @workspace/db db:studio",
    "dev": "turbo dev",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "ultracite": "^7.10.7"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
