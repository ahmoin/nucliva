{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "NEBIUS_API_KEY",
    "TAVILY_API_KEY",
    "LANGSMITH_TRACING",
    "LANGSMITH_API_KEY",
    "LANGSMITH_PROJECT",
    "NEBIUS_PROJECT_ID",
    "NEBIUS_SERVICE_ACCOUNT_ID",
    "NEBIUS_AUTHORIZED_KEY_ID",
    "NEBIUS_PRIVATE_KEY",
    "NEBIUS_AGENT_IMAGE",
    "NEBIUS_AGENT_PLATFORM",
    "NEBIUS_AGENT_PRESET",
    "NEBIUS_SUBNET_ID",
    "NEBIUS_SECRET_ID",
    "NOTION_CLIENT_ID",
    "NOTION_CLIENT_SECRET",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
