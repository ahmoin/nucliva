{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": ["!**/packages/db/drizzle"]
  },
  "overrides": [
    {
      "includes": ["**/postcss.config.*"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/db/**",
        "apps/web/lib/auth.ts",
        "apps/web/app/api/auth/**"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noNamespaceImport": "off"
          },
          "style": {
            "noExportedImports": "off"
          }
        }
      },
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/components/**",
        "packages/ui/src/hooks/**",
        "apps/web/components/app-sidebar.tsx",
        "apps/web/components/calendars.tsx",
        "apps/web/components/date-picker.tsx",
        "apps/web/components/nav-user.tsx",
        "apps/web/components/signup-form.tsx",
        "apps/web/components/login-form.tsx",
        "apps/web/app/dashboard/**",
        "apps/web/app/signup/**",
        "apps/web/app/login/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noSvgWithoutTitle": "off",
            "useFocusableInteractive": "off",
            "useSemanticElements": "off",
            "useValidAnchor": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off",
            "useExhaustiveDependencies": "off"
          },
          "performance": {
            "noJsxPropsBind": "off",
            "noNamespaceImport": "off"
          },
          "style": {
            "useConsistentTypeDefinitions": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noDoubleEquals": "off",
            "noLeakedRender": "off",
            "noShadow": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ]
}
